---
import { LOCALES, href, type Locale, type PageKey } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
  /** Page to link to in the other languages; pages without one (404) link to the home pages. */
  page?: PageKey;
}

const { lang, page = 'home' } = Astro.props;
const SHORT_LABEL: Record<Locale, string> = { fr: 'FR', en: 'EN', ar: 'ع' };
---

<div class="lang-switch" role="group" aria-label={t(lang).nav.language}>
  {
    LOCALES.map((code) => (
      <a href={href(page, code)} hreflang={code} lang={code} aria-current={code === lang ? 'true' : undefined}>
        <span aria-hidden="true">{SHORT_LABEL[code]}</span>
        <span class="visually-hidden">{t(code).languageName}</span>
      </a>
    ))
  }
</div>
